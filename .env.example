# LoopWear — Environment Configuration
# Run `npm run setup` to auto-generate a .env with secure random secrets.

PORT=3000
NODE_ENV=development

# Must match the origin of your frontend (no trailing slash)
CLIENT_ORIGIN=http://localhost:3000

# JWT secrets — use separate values, 64+ random hex characters each
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_SECURE_RANDOM_SECRET

# Supabase — get these from your project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
